ult":"./lib/index.js"},"./src/*":"./src/*","./invariant":{"types":"./lib/types/invariant.d.ts","default":"./lib/invariant.js"},"./package.json":"./package.json"},"_npmUser":{"name":"imccyu","email":"imccyu@gmail.com"},"_resolved":"/home/runner/work/deepseek-harness/deepseek-harness/dist/npm/deepseek-ai-dsh-brand-0.1.0-rc.2.tgz","_integrity":"sha512-rHsJpduZgQyT4+WbvoxhG53x+5QaBYO66dKx3QgkL0LE7e1nYubmRMyOtpdbykG3EDZvWkwbp0fWswSAheP2LQ==","repository":{"url":"git+https://github.com/deepseek-ai/deepseek-harness.git","type":"git","directory":"packages/util/brand"},"_npmVersion":"11.16.0","description":"Type-only Branded<B> nominal-typing primitive for the DeepSeek Harness","directories":{},"_nodeVersion":"24.18.0","publishConfig":{"access":"restricted"},"_hasShrinkwrap":false,"readmeFilename":"README.zh.md","devDependencies":{"@deepseek-ai/cordis":"^4.0.1","@deepseek-ai/dsh-invariants":"^0.1.0-rc.2"},"peerDependencies":{"@deepseek-ai/cordis":"^4.0.1","@deepseek-ai/dsh-invariants":"^0.1.0-rc.2"},"_npmOperationalInternal":{"tmp":"tmp/dsh-brand_0.1.0-rc.2_1786614205270_0.24240480767850547","host":"s3://npm-registry-packages-npm-production"},"_cnpmcore_publish_time":"2026-08-13T09:43:25.404Z","publish_time":1786614205404,"_source_registry_name":"default"}},"bugs":{"url":"https://github.com/deepseek-ai/deepseek-harness/issues"},"description":"Type-only Branded<B> nominal-typing primitive for the DeepSeek Harness","homepage":"https://github.com/deepseek-ai/deepseek-harness#readme","license":"BSD-3-Clause","maintainers":[{"name":"tianyicui-deepseek","email":"tianyi@deepseek.com"},{"name":"imccyu","email":"imccyu@gmail.com"}],"readme":"# dsh-brand\n\nEnglish | [中文](README.zh.md)\n\nThe `Branded<B>` nominal-typing primitive — a tiny, **type-only** package (no runtime code, no harness-package dependency) shared by every package that owns a cross-boundary id.\n\n## What `Branded` is\n\nA brand makes structurally-identical strings non-interchangeable at the type level: a `SessionId` cannot be passed where a `CallId` is expected, even though both are plain `string`s at runtime.\n\n```ts\nimport type { Branded } from '@deepseek-ai/dsh-brand'\n\nexport type SessionId = Branded<'SessionId'>\n\n/** Brand a string as a SessionId (a plain cast — zero runtime cost). */\nexport function SessionId(id: string): SessionId {\n  return id as SessionId\n}\n```\n\nConstruction goes through the per-id factory in the owning package. Comparison, logging, JSON serialization, and the wire format behave as for an ordinary string; the brand is erased at compile time.\n\n## Policy: brand ids that cross package boundaries\n\nA package brands the ids it owns — `CallId` in `dsh-llm`, the shared agent/session `SessionId` in `dsh-session`, and `TaskId` in `dsh-tasks`. Brand cross-package ids that could plausibly be confused; not every string needs one.\n\nThis package owns only the primitive. Keeping it dependency-free lets `dsh-tasks`, for example, brand `TaskId` without importing an unrelated capability package merely to reach `Branded`.\n","readmeFilename":"README.zh.md","repository":{"url":"git+https://github.com/deepseek-ai/deepseek-harness.git","type":"git","directory":"packages/util/brand"},"_source_registry_name":"default"}