eepseek-harness/issues"},"homepage":"https://github.com/deepseek-ai/deepseek-harness#readme","_integrity":"sha512-i1VXrZCbv6tk/iUgedCNjrxxArbWT3IvRZGB5sdqJ3ectnihivXXQbRZ8JJ73DSmAPvlMGmrbtjFAfm10yvXRg==","_resolved":"/home/runner/work/deepseek-harness/deepseek-harness/dist/npm-vendor/deepseek-ai-cordis-plugin-include-1.0.6.tgz","_from":"file:/home/runner/work/deepseek-harness/deepseek-harness/dist/npm-vendor/deepseek-ai-cordis-plugin-include-1.0.6.tgz","_nodeVersion":"24.19.0","_npmVersion":"11.17.0","dist":{"integrity":"sha512-i1VXrZCbv6tk/iUgedCNjrxxArbWT3IvRZGB5sdqJ3ectnihivXXQbRZ8JJ73DSmAPvlMGmrbtjFAfm10yvXRg==","shasum":"c40ac7343289eae63c7b7a52a44b9a88560754df","tarball":"https://registry.npmmirror.com/@deepseek-ai/cordis-plugin-include/-/cordis-plugin-include-1.0.6.tgz","fileCount":7,"unpackedSize":31844,"signatures":[{"keyid":"SHA256:DhQ8wR5APBvFHLF/+Tc+AYvPOdTpcIDqOhxsBHRwC7U","sig":"MEUCIQCYFDcpV4v8GihvFNzIBDio/mhyflbpmpaTSyu58VIHJgIgTdqd4v1EZl0RY8I3Z+V0/PuKdntK9NfKfRR5dTi8eFw="}],"size":8983},"_npmUser":{"name":"imccyu","email":"imccyu@gmail.com"},"directories":{},"maintainers":[{"name":"imccyu","email":"imccyu@gmail.com"},{"name":"tianyicui-deepseek","email":"tianyi@deepseek.com"}],"_npmOperationalInternal":{"host":"s3://npm-registry-packages-npm-production","tmp":"tmp/cordis-plugin-include_1.0.6_1786607380487_0.5648851298502304"},"_hasShrinkwrap":false,"_cnpmcore_publish_time":"2026-08-13T07:49:40.651Z","publish_time":1786607380651,"_source_registry_name":"default"}},"author":{"name":"Shigma","email":"shigma10826@gmail.com"},"bugs":{"url":"https://github.com/deepseek-ai/deepseek-harness/issues"},"description":"Include files in cordis configurations","homepage":"https://github.com/deepseek-ai/deepseek-harness#readme","license":"MIT","maintainers":[{"name":"tianyicui-deepseek","email":"tianyi@deepseek.com"},{"name":"imccyu","email":"imccyu@gmail.com"}],"readme":"# @cordisjs/plugin-include\n\nFile-backed loader tree for Cordis. The include plugin reads a YAML or JSON\nfile, turns it into loader entries, and writes updates back when the file is\nwritable.\n\n## Usage\n\n```ts\nimport { Context } from 'cordis'\nimport Loader from '@cordisjs/plugin-loader'\nimport Include from '@cordisjs/plugin-include'\n\nconst root = new Context()\nawait root.plugin(Loader, { baseUrl: import.meta.url })\nawait root.plugin(Include, {\n  path: './cordis.yml',\n  initial: [],\n  enableLogs: true,\n})\n```\n\nExample `cordis.yml`:\n\n```yaml\n- id: timer\n  name: '@cordisjs/plugin-timer'\n- id: app\n  name: ./plugins/app\n  config:\n    message: hello\n```\n\n## Config\n\n| Field | Description |\n| --- | --- |\n| `path` | YAML or JSON file path resolved from `ctx.baseUrl`. |\n| `initial` | Entry list written when the file is missing. |\n| `patches` | Runtime patches applied after reading the file. |\n| `enableLogs` | Enables loader apply, reload, and unload logs. |\n\nPatches can insert entries or override fields on entries with a matching `id`.\n","readmeFilename":"README.md","repository":{"type":"git","url":"git+https://github.com/deepseek-ai/deepseek-harness.git","directory":"vendor/include"},"_source_registry_name":"default"}